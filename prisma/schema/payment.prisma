enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  SSLCOMMERZ
  STRIPE
  SHURJOPAY
}

model Payment {
  id            String        @id @default(uuid())
  amount        Float
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  paymentMethod PaymentMethod
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Stripe fields
  stripePaymentIntentId String?   @unique
  stripeEventId         String?   @unique  
  stripeCustomerId      String?
  receiptUrl            String?
  metadata              Json?

  // Foreign Keys
  userId        String
  ideaId        String

  // Relations
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea          Idea          @relation(fields: [ideaId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([ideaId])
  @@index([status])
  @@index([transactionId])
  @@index([stripePaymentIntentId])
  @@index([stripeEventId])  
  @@map("payments")
}