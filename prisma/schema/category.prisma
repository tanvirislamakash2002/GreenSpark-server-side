model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  ideas       IdeaCategory[]

  @@map("categories")
}

model IdeaCategory {
  id          String   @id @default(uuid())
  ideaId      String
  categoryId  String
  createdAt   DateTime @default(now())

  idea        Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([ideaId, categoryId])
  @@index([ideaId])
  @@index([categoryId])
  @@map("idea_categories")
}